# Copie ce fichier en .env puis remplis les valeurs.
# Windows : copy .env.example .env

DISCORD_TOKEN=colle_ton_token_ici
CLIENT_ID=123456789012345678
# Facultatif : ID du serveur pour des commandes instantanees
GUILD_ID=123456789012345678
# URL du site GitHub Pages (utilisee par /embed aide et pour revenir apres connexion)
SITE_URL=https://yutsioff.github.io/embedforge/

# Envoi direct depuis le site : Developer Portal > OAuth2 > Client Secret
# Sans cette valeur, tout fonctionne sauf le bouton "Envoyer sur Discord".
DISCORD_CLIENT_SECRET=

# Port de l'API du bot (le site s'y connecte)
API_PORT=3000

# URL publique de l'API, utilisee pour le retour OAuth2.
# En local : http://localhost:3000
# En ligne : l'URL https de ton hebergement/tunnel, sans slash final
# A declarer dans Developer Portal > OAuth2 > Redirects :
#   <API_PUBLIC_URL>/auth/discord/callback
API_PUBLIC_URL=http://localhost:3000

# OAuth2 : URL EXACTEMENT identique a une Redirect URL du portail Discord
# (par defaut : API_PUBLIC_URL/auth/discord/callback)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
